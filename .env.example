DATABASE_URL=postgresql://user:password@host/dbname

# At least one LLM provider key is required. The LLM worker tries Groq first,
# then falls back to Gemini if Groq's daily quota is exhausted.
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional tuning (defaults shown)
# CLUSTER_THRESHOLD=0.42
# CLUSTER_LOOKBACK_HOURS=48
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_DAILY_TOKEN_BUDGET=90000
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_DAILY_TOKEN_BUDGET=900000
# SUMMARIZATION_DELAY=2.0
# LLM_WORKER_IDLE_SECONDS=30
# QUEUE_STUCK_MINUTES=30
# LOG_LEVEL=INFO

# Semantic clustering (Gemini embeddings + pgvector). Uses GEMINI_API_KEY above;
# separate rate-limit bucket from the summarization model. Set to false to use
# trigram-only clustering.
# CLUSTERING_USE_EMBEDDINGS=true
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSIONS=384
# EMBEDDING_BODY_CHARS=200
# EMBEDDING_REQUESTS_PER_MINUTE=100
# EMBEDDING_MAX_WAIT_SECONDS=240
# CLUSTER_EMBEDDING_THRESHOLD=0.85
# CLUSTER_HYBRID_EMBEDDING_THRESHOLD=0.80
# CLUSTER_HYBRID_TRIGRAM_THRESHOLD=0.35
